+/* Refinement contexts are stable for the duration of this pass. Pair only
+ * eligible coefficients, preserving stripe order and handling an odd tail. */
+void refine_pairs(MQ *m,__global const uchar *src,uint length,
+    __global int *data,__local uint *flags,int w,int h,int midpoint)
+{
+    int pending=-1,px=0,py=0; uint pc=0;
+    for(int stripe=0;stripe<h;stripe+=4) for(int x=0;x<w;++x)
+        for(int j=0;j<min(4,h-stripe);++j) {
+            int y=stripe+j,at=y*w+x;
+            uint f=sample_flags(flags,x,y,w);
+            if((f&(SIG|VISITED))!=SIG) continue;
+            uint context=14+((f&REFINED)?2:(f&NEIGHBORS)?1:0);
+            if(pending<0) { pending=at; px=x;py=y;pc=context; }
+            else {
+                uint2 bits=decision_pair(m,src,length,pc,context);
+                data[pending]+=(bits.x^(data[pending]<0))?midpoint:-midpoint;
+                data[at]+=(bits.y^(data[at]<0))?midpoint:-midpoint;
+                mark_flag(flags,px,py,w,1u<<20);mark_flag(flags,x,y,w,1u<<20);
+                pending=-1;
+            }
+        }
+    if(pending>=0) {
+        uint bit=decision(m,src,length,pc);
+        data[pending]+=(bit^(data[pending]<0))?midpoint:-midpoint;
+        mark_flag(flags,px,py,w,1u<<20);
+    }
+}
