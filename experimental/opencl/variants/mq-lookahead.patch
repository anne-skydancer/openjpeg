+uint decision_path(MQ *m, __global const uchar *src, uint length, uint context,uint low)
+{
+    uint4 s = mq_states[context_state(m,context)]; /* Qe, MPS, NMPS, NLPS */
+    uint bit;
+    m->a -= s.x;
+    if (low) {
+        if (m->a < s.x) { bit = s.y; set_context(m,context,s.z); }
+        else { bit = 1 - s.y; set_context(m,context,s.w); }
+        m->a = s.x;
+    } else {
+        m->c -= s.x << 16;
+        if (m->a & 0x8000) return s.y;
+        if (m->a < s.x) { bit = 1 - s.y; set_context(m,context,s.w); }
+        else { bit = s.y; set_context(m,context,s.z); }
+    }
+    do {
+        if (!m->ct) bytein(m, src, length);
+        m->a <<= 1; m->c <<= 1; --m->ct;
+    } while (m->a < 0x8000);
+    return bit;
+}
+/* Experimental two-decision lookahead. Evaluate both arithmetic exchange
+ * paths and their next decision, then commit only the actual first path.
+ * Speculative input accesses use the same bounded synthesized-byte reader. */
+uint2 decision_pair(MQ *m,__global const uchar *src,uint length,uint c0,uint c1)
+{
+    uint low=(m->c>>16)<mq_states[context_state(m,c0)].x;
+    MQ lower=*m,upper=*m;
+    uint l0=decision_path(&lower,src,length,c0,1);
+    uint u0=decision_path(&upper,src,length,c0,0);
+    uint l1=decision(&lower,src,length,c1);
+    uint u1=decision(&upper,src,length,c1);
+    if(low) { *m=lower; return (uint2)(l0,l1); }
+    *m=upper; return (uint2)(u0,u1);
+}
