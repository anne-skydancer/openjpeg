+            if(x<w) {
+                uint refined=0;
+                for(int j=0;j<rows;++j) if(contexts[4*lane+j]) {
+                    int at=(stripe+j)*w+x;
+                    data[at]+=(bits[4*lane+j]^(data[at]<0))?midpoint:-midpoint;
+                    refined |= 1u<<(20+3*j);
+                }
+                flags[(stripe>>2)*w+x] |= refined;
+            }
+            barrier(CLK_LOCAL_MEM_FENCE|CLK_GLOBAL_MEM_FENCE);
+        }
+    }
