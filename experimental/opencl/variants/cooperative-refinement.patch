+/* Experimental 32-lane refinement. Each lane owns a four-row column;
+ * only lane zero advances MQ, in the standard column/row decision order. */
+void refine_cooperative(MQ *m,__global const uchar *src,uint length,
+    __global int *data,__local uint *flags,int w,int h,uint raw,int midpoint,
+    __local uint *contexts,__local uint *bits)
