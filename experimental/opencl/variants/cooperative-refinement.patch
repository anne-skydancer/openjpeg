+    for(int stripe=0;stripe<h;stripe+=4) {
+        int rows=min(4,h-stripe);
+        for(int base=0;base<w;base+=32) {
+            int x=base+lane;
+            for(int j=0;j<4;++j) {
+                uint context=0;
+                if(x<w && j<rows) {
+                    uint f=sample_flags(flags,x,stripe+j,w);
+                    if((f&(SIG|VISITED))==SIG)
